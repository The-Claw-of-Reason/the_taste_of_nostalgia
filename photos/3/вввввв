        gercules:{tag:"Зал5 · Каша",title:"Геркулес",img:"https://images.unsplash.com/photo-1515705576963-95b71c06d5c7?w=800",history:"С ягодами",ingredients:["Хлопья","Ягоды","Мёд"],steps:["Заварить"]},
