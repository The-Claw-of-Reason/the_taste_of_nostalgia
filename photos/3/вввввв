        moloko:{tag:"Зал5 · Напиток",title:"Тёплое молоко",img:"https://images.unsplash.com/photo-1563636619-e9143da7973b?w=800",history:"Перед сном",ingredients:["Молоко","Мёд"],steps:["Подогреть"]},
        sgushenka:{tag:"Зал5 · Сладость",title:"Сгущёнка",img:"https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=800",history:"Сладкое поощрение",ingredients:["Сгущёнка"],steps:["Открыть и наслаждаться"]}
    };

    // структура залов (вертикальная)
    const hallsData = [
        { name:"Зал 1 · Русская печь", items:["shchi","kasha","rastegaс","kisel","kalach","sbiten","perepelacha","medovukha"], panorama:"photos/IMG_20260427_214718_720.jpg", textPan:"🔥 Жар русской печи согревал весь дом. Щи томились сутки, гречневая каша в чугунках, пряный сбитень спасал от стужи." },
        { name:"Зал 2 · Имперский пир", items:["beefstroganoff","pirozhok_osetr","kulebyaka","ptifur","samovar","seledka_shuba","kholodets","vinaigret"], panorama:"photos/IMG_20260427_214720_960.jpg", textPan:"🥂 Хрусталь, серебро и многослойные кулебяки. Бефстроганов для графа, осетрина для императора." },
        { name:"Зал 3 · Советская столовая", items:["kotleta","olivier","kompot","pechenie","podnos","makarony_flotski","syrniki","kompot_3"], panorama:"photos/IMG_20260427_214722_982.jpg", textPan:"🍴 Очередь за котлетой и стакан компота. Оливье под майонезом, сырники, макароны по-флотски." },
        { name:"Зал 4 · У бабушки на кухне", items:["vareniki","solenya","bliny_ikra","kurik","oladi","bliny_2","kisel_2","sgushenka_4"], panorama:"photos/IMG_20260427_214725_873.jpg", textPan:"👵 Вареники лепятся всей семьёй, солёные огурцы из погреба. Бабушкины блины с икрой, курник." },
        { name:"Зал 5 · Утро перед детским садом", items:["kakao","butterbrod","ovs_kasha","ovs_pechenie","gercules","bulochka","moloko","sgushenka"], panorama:"photos/IMG_20260427_213125_388.jpg", textPan:"🧸 Какао с пенкой, масляный бутерброд, овсяная каша «Геркулес», сдобная булочка, сгущёнка." }
    ];
    // глобальный контроль аудио
    let globalAudio = null;
    let currentVinylElem = null;

    function stopCurrentAudio() {
        if(globalAudio) {
            globalAudio.pause();
            globalAudio = null;
        }
        if(currentVinylElem) {
            currentVinylElem.classList.remove("spinning");
            currentVinylElem = null;
        }
    }

    function buildVerticalHalls() {
        const container = document.getElementById("hallsStack");
        container.innerHTML = "";
        hallsData.forEach((hall, idx) => {
            const card = document.createElement("div");
            card.className = "hall-card";
            const panoramaDiv = document.createElement("div");
            panoramaDiv.className = "hall-panorama";
            panoramaDiv.style.backgroundImage = `url(${hall.panorama})`;
            const textSpan = document.createElement("div");
            textSpan.className = "panorama-text";
            textSpan.innerText = hall.textPan;
            panoramaDiv.appendChild(textSpan);
            const vinyl = document.createElement("div");
            vinyl.className = "vinyl-player";
            panoramaDiv.appendChild(vinyl);
            const titleDiv = document.createElement("div");
            titleDiv.className = "hall-title";
            titleDiv.innerText = hall.name;
            const carouselBlock = document.createElement("div");
            carouselBlock.className = "carousel-block";
            carouselBlock.innerHTML = `<div class="carousel-label">🍽️ Нажмите на карточку — откроется рецепт</div><div class="track-outer" id="trackOuter${idx}"><div class="cards-track" id="track${idx}"></div></div><div class="carousel-nav"><button class="c-arrow prevBtn" data-idx="${idx}">←</button><span class="c-counter" id="counter${idx}">1/1</span><button class="c-arrow nextBtn" data-idx="${idx}">→</button></div>`;
            card.appendChild(panoramaDiv);
            card.appendChild(titleDiv);
            card.appendChild(carouselBlock);
            container.appendChild(card);

            const trackDiv = document.getElementById(`track${idx}`);
            hall.items.forEach(key => {
                let exKey = key;
                if(key === "rastegaс") exKey = "rastegaс"; // исправляем опечатку ключа
                const ex = exhibitsDB[exKey];
                if(ex) {
                    const cardEx = document.createElement("div");
                    cardEx.className = "expo-card";
                    cardEx.setAttribute("data-key", exKey);
                    cardEx.innerHTML = `<img class="expo-img" src="${ex.img}" alt="${ex.title}"><div class="expo-info"><div class="expo-name">${ex.title}</div><div class="expo-type">${ex.tag || "Экспонат"}</div></div>`;
                    cardEx.onclick = (e) => { e.stopPropagation(); openModal(exKey); };
                    trackDiv.appendChild(cardEx);
                }
            });
            initCarouselScroll(idx);
            // аудио для пластинки
            const audio = new Audio("https://www.soundhelix.com/examples/mp3/SoundHelix-Song-2.mp3");
            audio.loop = true;
            vinyl.addEventListener("click", (e) => {
                e.stopPropagation();
                if(globalAudio === audio && currentVinylElem === vinyl && !audio.paused) {
                    stopCurrentAudio();
                } else {
                    stopCurrentAudio();
                    globalAudio = audio;
                    currentVinylElem = vinyl;
                    audio.play().catch(err => console.log("автовоспроизведение заблокировано"));
                    vinyl.classList.add("spinning");
                }
            });
            audio.addEventListener("ended", () => {
                if(globalAudio === audio) {
                    vinyl.classList.remove("spinning");
                    globalAudio = null;
                    currentVinylElem = null;
                }
            });
        });
    }

    function initCarouselScroll(idx) {
        const outer = document.getElementById(`trackOuter${idx}`);
        const track = document.getElementById(`track${idx}`);
        if(!outer || !track) return;
        const cards = track.querySelectorAll('.expo-card');
        const total = cards.length;
        if(total === 0) return;
        const updateCounter = () => {
            const scrollLeft = outer.scrollLeft;
            let cardWidth = 220 + 20; // ширина + gap
            if(window.innerWidth <= 700) cardWidth = 180 + 20;
            const activeIndex = Math.round(scrollLeft / cardWidth);
            const safeIdx = Math.min(Math.max(activeIndex,0), total-1);
            document.getElementById(`counter${idx}`).innerText = `${safeIdx+1}/${total}`;
        };
        const scrollToIndex = (index) => {
            let cardWidth = 220 + 20;
            if(window.innerWidth <= 700) cardWidth = 180 + 20;
            const newLeft = index * cardWidth;
            outer.scrollTo({ left: newLeft, behavior: 'smooth' });
            setTimeout(updateCounter, 150);
        };
        let currentIdx = 0;
        const next = () => { currentIdx = (currentIdx + 1) % total; scrollToIndex(currentIdx); };
        const prev = () => { currentIdx = (currentIdx - 1 + total) % total; scrollToIndex(currentIdx); };
        const prevBtn = document.querySelector(`.prevBtn[data-idx="${idx}"]`);
        const nextBtn = document.querySelector(`.nextBtn[data-idx="${idx}"]`);
        if(prevBtn) prevBtn.onclick = () => prev();
        if(nextBtn) nextBtn.onclick = () => next();
        outer.addEventListener("scroll", updateCounter);
        updateCounter();
    }

    // модалка, рецепты, сохранения
    let currentModalKey = null;
    function openModal(key) {
        const ex = exhibitsDB[key];
        if(!ex) return;
        currentModalKey = key;
        document.getElementById("modalImg").src = ex.img;
        document.getElementById("modalTag").innerText = ex.tag || "Экспонат";
        document.getElementById("modalTitle").innerText = ex.title;
        document.getElementById("modalHistory").innerText = ex.history || "Кулинарная легенда.";
        const panel = document.getElementById("recipePanel");
        const inner = document.getElementById("recipeInner");
        if(ex.ingredients && ex.ingredients.length) {
            inner.innerHTML = `<h4>🥄 Ингредиенты:</h4><ul>${ex.ingredients.map(i=>`<li>${i}</li>`).join('')}</ul><h4>🍳 Приготовление:</h4><ol>${ex.steps.map(s=>`<li>${s}</li>`).join('')}</ol>`;
            document.getElementById("recipeToggleBtn").style.display = "inline-flex";
        } else {
            inner.innerHTML = "<p>Нет рецепта, но вы можете сохранить память.</p>";
            document.getElementById("recipeToggleBtn").style.display = "none";
        }
        panel.classList.remove("open");
        document.getElementById("modalBg").classList.add("open");
    }
    window.closeModal = () => document.getElementById("modalBg").classList.remove("open");
    document.getElementById("modalBg").addEventListener("click", e => { if(e.target === document.getElementById("modalBg")) closeModal(); });
    document.getElementById("recipeToggleBtn").addEventListener("click", () => {
        document.getElementById("recipePanel").classList.toggle("open");
    });

    let savedRecipes = JSON.parse(localStorage.getItem("savedRecipes")) || [];
    function renderRecipeBook() {
        const grid = document.getElementById("recipesGrid");
        if(savedRecipes.length === 0) {
            grid.innerHTML = '<div class="empty-recipes-msg">✨ Пока нет рецептов. Сохраните из карточек экспозиции или добавьте свой!</div>';
            return;
        }
        grid.innerHTML = savedRecipes.map((r, idx) => `
            <div class="recipe-card" data-recipe-idx="${idx}">
                <img class="recipe-img" src="${r.img || 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=400'}" alt="${r.title}">
                <button class="delete-recipe" data-id="${r.id || idx}" title="Удалить рецепт">🗑️</button>
                <div class="recipe-info">
                    <div class="recipe-title">${escapeHtml(r.title)}</div>
                    <span class="recipe-tag">${escapeHtml(r.tag)}</span>
                    <div style="font-size:0.75rem; margin-top:0.5rem; color:#5a3e2a;"><strong>Ингредиенты:</strong> ${escapeHtml(r.ingredients).substring(0,60)}${r.ingredients.length>60?'…':''}</div>
                </div>
            </div>
        `).join('');
        // привязать удаление
        document.querySelectorAll('.delete-recipe').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const recipeDiv = btn.closest('.recipe-card');
                const idxAttr = recipeDiv.getAttribute('data-recipe-idx');
                if(idxAttr !== null && confirm('Удалить рецепт из книги?')) {
                    const idxNum = parseInt(idxAttr,10);
                    savedRecipes.splice(idxNum, 1);
                    localStorage.setItem("savedRecipes", JSON.stringify(savedRecipes));
                    renderRecipeBook();
                }
            });
        });
    }
    function escapeHtml(str) { if(!str) return ''; return str.replace(/[&<>]/g, function(m){if(m==='&') return '&amp;'; if(m==='<') return '&lt;'; if(m==='>') return '&gt;'; return m;});}
    function saveCurrentToBook() {
        if(!currentModalKey) return;
        const ex = exhibitsDB[currentModalKey];
        if(!ex) return;
        const newRec = { id:Date.now(), title:ex.title, tag:ex.tag, ingredients:ex.ingredients?.join("\n")||"", steps:ex.steps?.join("\n")||"", img:ex.img };
        if(!savedRecipes.some(r=>r.title === newRec.title && r.ingredients === newRec.ingredients)) {
            savedRecipes.push(newRec);
            localStorage.setItem("savedRecipes", JSON.stringify(savedRecipes));
            alert("✅ Рецепт сохранён в книгу!");
            renderRecipeBook();
        } else alert("Этот рецепт уже есть в книге");
    }
    document.getElementById("saveRecipeModalBtn").addEventListener("click", saveCurrentToBook);
    document.getElementById("addCustomRecipeBtn").addEventListener("click", () => {
        const title = document.getElementById("newTitle").value.trim();
        if(!title) return alert("Введите название блюда");
        const newR = { id:Date.now(), title, tag:document.getElementById("newTag").value, ingredients:document.getElementById("newIngredients").value, steps:document.getElementById("newSteps").value, img:"https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=400" };
        savedRecipes.push(newR);
        localStorage.setItem("savedRecipes", JSON.stringify(savedRecipes));
        renderRecipeBook();
        alert("Рецепт добавлен!");
        document.getElementById("newTitle").value = "";
        document.getElementById("newIngredients").value = "";
        document.getElementById("newSteps").value = "";
    });

    function showMain() {
        document.getElementById("mainPage").style.display = "block";
        document.getElementById("recipesPage").classList.remove("active");
        document.getElementById("mainTabBtn").classList.add("active");
        document.getElementById("recipesTabBtn").classList.remove("active");
    }
    function showRecipes() {
        document.getElementById("mainPage").style.display = "none";
        document.getElementById("recipesPage").classList.add("active");
        renderRecipeBook();
        document.getElementById("mainTabBtn").classList.remove("active");
        document.getElementById("recipesTabBtn").classList.add("active");
    }
    document.getElementById("mainTabBtn").onclick = showMain;
    document.getElementById("recipesTabBtn").onclick = showRecipes;

    buildVerticalHalls();
    showMain();
</script>
